    <mxCell id="e_eval_itf" value="*        1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="cls_evaluacion" target="itf_evaluador">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Evaluacion 1 - * CalificacionRAP (composición) -->
    <mxCell id="e_eval_califrap" value="1        1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;endArrow=none;" edge="1" parent="1" source="cls_evaluacion" target="cls_califrap">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- CalificacionRAP *-1 RAP -->
    <mxCell id="e_califrap_rap" value="*        1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="cls_califrap" target="cls_rap">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Reporte - Programa/Momento (dependencia) -->
    <mxCell id="e_reporte_mom" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="cls_reporte" target="cls_evaluacion">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
