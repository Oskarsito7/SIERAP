        <mxCell id="e114" value="«use»" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endSize=10;startSize=12;endArrow=open;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="Report" target="Evaluation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t115" value="&lt;b style='font-size:20px'&gt;SIERAP — class diagram (detailed design)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='font-size:12px;color:#555'&gt;Stage 1 close · 2026-09-28 · names in English (ADR-014); same model as diagrama_clases.md&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="t116" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Class colors: &lt;span style='background:#dae8fc'&gt;&amp;nbsp;users&amp;nbsp;&lt;/span&gt; &lt;span style='background:#e1d5e7'&gt;&amp;nbsp;accounts and sessions&amp;nbsp;&lt;/span&gt; &lt;span style='background:#d5e8d4'&gt;&amp;nbsp;academic configuration&amp;nbsp;&lt;/span&gt; &lt;span style='background:#ffe6cc'&gt;&amp;nbsp;operations&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style='background:#fff2cc'&gt;&amp;nbsp;evaluation&amp;nbsp;&lt;/span&gt; &lt;span style='background:#f5f5f5'&gt;&amp;nbsp;reports&amp;nbsp;&lt;/span&gt; &lt;span style='background:#f8cecc'&gt;&amp;nbsp;enumerations&amp;nbsp;&lt;/span&gt;&lt;br&gt;Dashed border: designed, not built yet (IndividualGrade in Stage 6, ADR-018; reports in Stage 7).&lt;br&gt;Also designed only: &lt;i&gt;ProjectGroup.getFinalGrade()&lt;/i&gt; and the &lt;i&gt;Evaluation&lt;/i&gt; methods per student (Stage 6).&lt;br&gt;&lt;i&gt;Italics&lt;/i&gt;: abstract class or method. Multiplicities at each end of the associations." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#999999;fillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1640" y="1940" width="600" height="330" as="geometry"/></mxCell>
