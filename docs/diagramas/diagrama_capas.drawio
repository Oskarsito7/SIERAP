        <mxCell id="c30" value="stores / reads files" style="text;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=11;fontColor=#4B5563;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="815" y="1403" width="220" height="16" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Architecture rules&lt;/b&gt;&lt;br&gt;• Each layer only uses the one right below it.&lt;br&gt;• JPA entities never leave the API: controllers answer with DTOs.&lt;br&gt;• No business logic in the controllers.&lt;br&gt;• No scattered try/catch: services throw SierapException subclasses and exception translates them.&lt;br&gt;• No hard-coded business values (ADR-010).&lt;br&gt;• Dashed border: planned, not built yet." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FFFBEB;strokeColor=#D4A017;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="1430" width="440" height="170" as="geometry"/></mxCell>
