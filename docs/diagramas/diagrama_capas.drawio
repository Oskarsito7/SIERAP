        <mxCell id="c1" value="SIERAP — Layered architecture (package diagram)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=22;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="c2" value="React web client + REST API in Spring Boot organized into presentation, business logic, data and entities (the four layers of the rubric, RAP2), with cross-cutting components. Names in English (ADR-014) · Stage 1 close · 2026-09-29 · same content as diagrama_capas.md" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1900" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b style="font-size:15px"&gt;PRESENTATION — web client&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B"&gt;frontend · React 19 + TypeScript (SPA) · Vite · Tailwind CSS v4 + shadcn/ui · React Router · axios&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F5F9FF;strokeColor=#93B4E0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1920" height="250" as="geometry"/></mxCell>
        <mxCell id="fe_pages" value="&lt;b&gt;pages&lt;/b&gt;&lt;br&gt;views per role: auth, groups,&lt;br&gt;registrationCodes, account …&lt;br&gt;never call axios directly" style="shape=folder;tabWidth=70;tabHeight=20;tabPosition=left;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=22;fillColor=#DBEAFE;strokeColor=#3B6FB6;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="fe_comp" value="&lt;b&gt;components&lt;/b&gt;&lt;br&gt;ui (shadcn/ui), layout with&lt;br&gt;the menu of each role, forms" style="shape=folder;tabWidth=110;tabHeight=20;tabPosition=left;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=22;fillColor=#DBEAFE;strokeColor=#3B6FB6;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="384" y="180" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="fe_routes" value="&lt;b&gt;routes&lt;/b&gt;&lt;br&gt;AppRouter · RequireRole&lt;br&gt;routes protected by role" style="shape=folder;tabWidth=78;tabHeight=20;tabPosition=left;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=22;fillColor=#DBEAFE;strokeColor=#3B6FB6;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="698" y="180" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="fe_auth" value="&lt;b&gt;auth&lt;/b&gt;&lt;br&gt;AuthProvider: session and user,&lt;br&gt;access token in memory" style="shape=folder;tabWidth=62;tabHeight=20;tabPosition=left;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=22;fillColor=#DBEAFE;strokeColor=#3B6FB6;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1012" y="180" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="fe_api" value="&lt;b&gt;services / api&lt;/b&gt;&lt;br&gt;httpClient (axios): Bearer JWT and&lt;br&gt;refresh with the sierap_refresh cookie;&lt;br&gt;one typed service per resource" style="shape=folder;tabWidth=142;tabHeight=20;tabPosition=left;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=22;fillColor=#DBEAFE;strokeColor=#3B6FB6;fontFamily=Arial;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1326" y="180" width="290" height="140" as="geometry"/></mxCell>
