        <mxCell id="c53" value='&lt;b style="font-size:15px"&gt;4. Role hierarchy and access scope&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B"&gt;Each level sees only a subset of what the level above sees&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;connectable=0;" vertex="1" parent="1"><mxGeometry x="1370" y="830" width="930" height="690" as="geometry"/></mxCell>
        <mxCell id="sa" value="&lt;b&gt;Super Admin&lt;/b&gt;&lt;br&gt;Scope: the whole institution&lt;br&gt;parameters, periods, faculties, evaluator types" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#DBEAFE;strokeColor=#3B6FB6;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="905" width="340" height="72" as="geometry"/></mxCell>
