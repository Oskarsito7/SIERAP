<mxfile host="app.diagrams.net" agent="SIERAP generator"><diagram name="Diagrama de jerarquías" id="Diagrama-de-jerarqu-as"><mxGraphModel dx="2000" dy="1520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="x0" value="&lt;b style=&quot;font-size:15px&quot;&gt;1. Jerarquía de herencia — Usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Abstracción + herencia + interfaz: la base de la POO del proyecto&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;movable=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="940" height="640" as="geometry"/></mxCell>
<mxCell id="x1" value="&lt;b style=&quot;font-size:15px&quot;&gt;2. Jerarquías de herencia — Reportes y excepciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Polimorfismo en la reportería y manejo centralizado de errores&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;movable=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="940" height="640" as="geometry"/></mxCell>
<mxCell id="x2" value="&lt;b style=&quot;font-size:15px&quot;&gt;3. Jerarquía institucional y académica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Configuración (super_admin / admin) → operación de cada momento (docente, estudiantes, evaluadores)&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;movable=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="940" height="720" as="geometry"/></mxCell>
<mxCell id="x3" value="&lt;b style=&quot;font-size:15px&quot;&gt;4. Jerarquía de roles y alcance de acceso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Cada nivel ve solo un subconjunto de lo que ve el nivel superior&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;movable=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="940" height="720" as="geometry"/></mxCell>
