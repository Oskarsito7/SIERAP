        <mxCell id="adj" value="&lt;b&gt;Individual adjustment&lt;/b&gt;&lt;br&gt;another level for one student in a criterion (ADR-018)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fillColor=#EDE4FB;strokeColor=#7E57C2;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="1400" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="adr018" value="The group is graded once and every member inherits its levels. The individual grade, with the adjustments, is each student's final grade." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FFFBEB;strokeColor=#D4A017;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="95" y="1300" width="195" height="112" as="geometry"/></mxCell>
