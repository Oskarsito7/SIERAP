        <mxCell id="e13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3F4A5A;strokeWidth=1.3;endArrow=none;exitX=0.8984;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.87;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ExternalEvaluator" target="EvaluatorType"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="is of type" style="text;html=1;align=right;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=11;fontColor=#4B5563;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1195" y="322" width="84" height="16" as="geometry"/></mxCell>
        <mxCell id="c15" value="*" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=11;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1290" y="432" width="20" height="16" as="geometry"/></mxCell>
        <mxCell id="c16" value="1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=11;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1290" y="288" width="20" height="16" as="geometry"/></mxCell>
        <mxCell id="why" value='&lt;b&gt;Why this way?&lt;/b&gt;&lt;br&gt;• &lt;i&gt;User&lt;/i&gt; is abstract: there is no "generic user", only the five concrete roles.&lt;br&gt;• &lt;i&gt;getRole()&lt;/i&gt; is polymorphic: each subclass overrides it and Spring Security decides the permissions with that value.&lt;br&gt;• &lt;i&gt;Teacher&lt;/i&gt; and &lt;i&gt;ExternalEvaluator&lt;/i&gt; grade groups but have no parent of their own for that: the shared behavior is the &lt;i&gt;Evaluator&lt;/i&gt; interface, and each one implements its own &lt;i&gt;canEvaluate()&lt;/i&gt; rule (the teacher who enabled the group, the evaluators assigned to it).&lt;br&gt;• Business person, alumnus and the types created later are rows of the &lt;i&gt;EvaluatorType&lt;/i&gt; catalog, not classes (ADR-011).&lt;br&gt;• &lt;i&gt;Student&lt;/i&gt;, &lt;i&gt;Admin&lt;/i&gt; and &lt;i&gt;SuperAdmin&lt;/i&gt; do not grade, so they do not implement &lt;i&gt;Evaluator&lt;/i&gt;: there is no self-assessment.&lt;br&gt;• JPA maps the inheritance with @Inheritance(JOINED): an app_user table plus one table per role (ADR-009).' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FFFBEB;strokeColor=#D4A017;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="622" width="1245" height="140" as="geometry"/></mxCell>
        <mxCell id="c17" value='&lt;b style="font-size:15px"&gt;2. Inheritance hierarchies — Reports and exceptions&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B"&gt;Polymorphism in reporting and centralized error handling&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontColor=#334155;connectable=0;" vertex="1" parent="1"><mxGeometry x="1370" y="100" width="930" height="700" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Reports&lt;/b&gt; — each type implements its own generate() · designed, built in Stage 7" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;whiteSpace=nowrap;connectable=0;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontSize=12;fontColor=#334155;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1395" y="150" width="870" height="20" as="geometry"/></mxCell>
