# Normaliza finales de línea para que el repo funcione igual en Windows, macOS y Linux.
* text=auto

# Scripts de shell siempre con LF (si no, ./mvnw falla en Linux/macOS/CI).
mvnw text eol=lf
*.sh text eol=lf

# Scripts de Windows siempre con CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios.
*.png binary
*.jpg binary
*.pptx binary
*.jar binary
